{% comment %}
  KitchuLab — 404 Page Template
{% endcomment %}

<div class="section">
  <div class="container">
    <div class="page-404">
      <div class="page-404__code">4<span>0</span>4</div>
      <h1 class="page-404__title">{{ 'general.404.title' | t }}</h1>
      <p class="page-404__text">{{ 'general.404.subtext' | t }}</p>

      <form action="/search" method="get" class="page-404__search" role="search">
        <input type="hidden" name="type" value="product">
        <label for="search-404" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
        <input
          type="search"
          name="q"
          id="search-404"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          aria-label="{{ 'general.search.placeholder' | t }}"
        >
        <button type="submit" class="btn btn--primary" aria-label="{{ 'general.search.submit' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </form>

      <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;">
        <a href="/" class="btn btn--primary">{{ 'general.404.back_to_home' | t }}</a>
        <a href="/collections/all" class="btn btn--secondary">{{ 'collections.general.continue_shopping' | t }}</a>
      </div>

      <div style="margin-top:3rem;">
        <p style="font-size:0.875rem;font-weight:600;color:#1B2A3B;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.06em;">
          {{ 'general.404.popular_categories' | t }}
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;">
          <a href="/collections/kitchen-tools" class="btn btn--secondary btn--sm">{{ 'navigation.kitchen_tools' | t }}</a>
          <a href="/collections/knives" class="btn btn--secondary btn--sm">{{ 'navigation.knives' | t }}</a>
          <a href="/collections/tableware" class="btn btn--secondary btn--sm">{{ 'navigation.tableware' | t }}</a>
          <a href="/collections/bar-equipment" class="btn btn--secondary btn--sm">{{ 'navigation.bar_equipment' | t }}</a>
          <a href="/collections/baking" class="btn btn--secondary btn--sm">{{ 'navigation.baking' | t }}</a>
        </div>
      </div>
    </div>
  </div>
</div>
