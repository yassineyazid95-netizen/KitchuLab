{% comment %}
  KitchuLab — Cart Template
  Full cart page with table layout and order summary
{% endcomment %}

<div class="page-hero">
  <div class="container">
    {% render 'breadcrumb' %}
    <h1 class="page-hero__title">{{ 'cart.general.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <p class="page-hero__meta">{{ 'cart.general.item_count' | t: count: cart.item_count }}</p>
    {%- endif -%}
  </div>
</div>

<div class="section">
  <div class="container">

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart, novalidate: 'novalidate' -%}
        <div class="cart-layout">

          {%- comment -%} Cart Items Table {%- endcomment -%}
          <div class="cart-items">
            <table class="cart-table" role="table">
              <thead>
                <tr>
                  <th scope="col">{{ 'cart.label.product' | t }}</th>
                  <th scope="col" class="text-center" style="min-width:120px;">{{ 'cart.label.quantity' | t }}</th>
                  <th scope="col" class="text-right">{{ 'cart.label.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in cart.items -%}
                  <tr>
                    {%- comment -%} Product Info {%- endcomment -%}
                    <td>
                      <div class="cart-item">
                        <div class="cart-item__image">
                          {%- if item.image != blank -%}
                            <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                              <img
                                src="{{ item.image | img_url: '160x160', crop: 'center' }}"
                                alt="{{ item.image.alt | default: item.title | escape }}"
                                loading="lazy"
                                width="80"
                                height="80"
                              >
                            </a>
                          {%- endif -%}
                        </div>
                        <div>
                          <p class="cart-item__title">
                            <a href="{{ item.url }}">{{ item.product.title }}</a>
                          </p>
                          {%- if item.variant.title != 'Default Title' -%}
                            <p class="cart-item__variant">{{ item.variant.title }}</p>
                          {%- endif -%}
                          {%- if item.selling_plan_allocation != blank -%}
                            <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}
                          <p class="cart-price" style="margin-top:0.5rem;">{{ item.price | money }}</p>
                          <button
                            type="button"
                            class="cart-item__remove"
                            data-remove-item="{{ item.key }}"
                            aria-label="{{ 'cart.general.remove' | t }}: {{ item.title | escape }}"
                          >
                            {{ 'cart.general.remove' | t }}
                          </button>
                        </div>
                      </div>
                    </td>

                    {%- comment -%} Quantity {%- endcomment -%}
                    <td class="text-center">
                      <div class="quantity-selector" style="margin:0 auto;width:fit-content;">
                        <button
                          class="quantity-btn"
                          type="button"
                          data-action="decrease"
                          aria-label="{{ 'products.product.decrease_quantity' | t }}"
                        >
                          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        </button>
                        <input
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          class="quantity-input"
                          aria-label="{{ 'cart.label.quantity' | t }}: {{ item.title | escape }}"
                          data-cart-quantity="{{ item.key }}"
                        >
                        <button
                          class="quantity-btn"
                          type="button"
                          data-action="increase"
                          aria-label="{{ 'products.product.increase_quantity' | t }}"
                        >
                          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </div>
                    </td>

                    {%- comment -%} Line Total {%- endcomment -%}
                    <td>
                      <p class="cart-total-price">{{ item.final_line_price | money }}</p>
                      {%- if item.original_line_price != item.final_line_price -%}
                        <p class="price price--compare" style="text-align:right;font-size:0.875rem;">{{ item.original_line_price | money }}</p>
                      {%- endif -%}
                    </td>
                  </tr>

                  {%- comment -%} Line-level discounts {%- endcomment -%}
                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <tr>
                      <td colspan="3">
                        {%- for discount_allocation in item.line_level_discount_allocations -%}
                          <p style="font-size:0.8125rem;color:#16a34a;display:flex;align-items:center;gap:0.375rem;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="7" y1="7" x2="7.01" y2="7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            {{ discount_allocation.discount_application.title }} (–{{ discount_allocation.amount | money }})
                          </p>
                        {%- endfor -%}
                      </td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>

            {%- comment -%} Cart Notes {%- endcomment -%}
            <div style="margin-top:1.5rem;">
              <label for="cart-note" style="display:block;font-size:0.875rem;font-weight:600;color:#1B2A3B;margin-bottom:0.5rem;">
                {{ 'cart.general.note' | t }}
              </label>
              <textarea
                id="cart-note"
                name="note"
                rows="3"
                style="width:100%;padding:0.75rem;border:1px solid #e5e7eb;border-radius:4px;font-family:inherit;font-size:0.875rem;resize:vertical;"
                placeholder="{{ 'cart.general.note_placeholder' | t }}"
              >{{ cart.note }}</textarea>
            </div>

            <div style="margin-top:1rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
              <a href="/collections/all" class="btn btn--secondary">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ 'cart.general.continue_shopping' | t }}
              </a>
              <button type="submit" name="update" class="btn btn--secondary">
                {{ 'cart.general.update_cart' | t }}
              </button>
            </div>
          </div>

          {%- comment -%} Order Summary Sidebar {%- endcomment -%}
          <div class="cart-summary">
            <h2 class="cart-summary__title">{{ 'cart.general.order_summary' | t }}</h2>

            <div class="cart-summary__row">
              <span class="cart-summary__label">{{ 'cart.general.subtotal' | t }}</span>
              <span class="cart-summary__value">{{ cart.total_price | money }}</span>
            </div>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount_application in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row" style="color:#16a34a;">
                  <span class="cart-summary__label">{{ discount_application.title }}</span>
                  <span class="cart-summary__value">–{{ discount_application.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}

            <div class="cart-summary__row">
              <span class="cart-summary__label">{{ 'cart.general.shipping' | t }}</span>
              <span class="cart-summary__value" style="color:#16a34a;">{{ 'cart.general.calculated_at_checkout' | t }}</span>
            </div>

            <div class="cart-summary__total">
              <span class="cart-summary__total-label">{{ 'cart.general.total' | t }}</span>
              <span class="cart-summary__total-value">{{ cart.total_price | money }}</span>
            </div>

            <p class="cart-summary__note">
              {%- if cart.taxes_included -%}
                {{ 'cart.general.taxes_included' | t }}
              {%- else -%}
                {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
              {%- endif -%}
            </p>

            <div class="cart-summary__actions">
              <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor" stroke-width="2"/>
                  <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ 'cart.general.checkout' | t }}
              </button>

              {%- if additional_checkout_buttons -%}
                <div class="additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} Trust Signals {%- endcomment -%}
            <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid #e5e7eb;">
              <div style="display:flex;flex-direction:column;gap:0.75rem;">
                <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.8125rem;color:#6b7280;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:#E87722;flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                  <span>{{ 'cart.trust.secure_checkout' | t }}</span>
                </div>
                <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.8125rem;color:#6b7280;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:#E87722;flex-shrink:0;"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{{ 'cart.trust.free_returns' | t }}</span>
                </div>
                <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.8125rem;color:#6b7280;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:#E87722;flex-shrink:0;"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 8v4l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <span>{{ 'cart.trust.fast_dispatch' | t }}</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      {%- endform -%}

    {%- else -%}
      {%- comment -%} Empty Cart {%- endcomment -%}
      <div class="cart-empty">
        <div class="cart-empty__icon">
          <svg viewBox="0 0 72 72" fill="none">
            <circle cx="36" cy="36" r="34" stroke="currentColor" stroke-width="2"/>
            <path d="M22 28h28l-3.5 18H25.5L22 28z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M29 28V23a7 7 0 0 1 14 0v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="30" cy="43" r="1.5" fill="currentColor"/>
            <circle cx="42" cy="43" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <h2 class="cart-empty__title">{{ 'cart.general.empty_cart_title' | t }}</h2>
        <p class="cart-empty__text">{{ 'cart.general.empty_cart_description' | t }}</p>
        <a href="/collections/all" class="btn btn--primary btn--lg">
          {{ 'cart.general.start_shopping' | t }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>
