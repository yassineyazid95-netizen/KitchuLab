[
  {
    "name": "theme_info",
    "theme_name": "KitchuLab",
    "theme_version": "1.0.0",
    "theme_author": "KitchuLab",
    "theme_documentation_url": "https://kitchulab.com/theme-docs",
    "theme_support_url": "https://kitchulab.com/support"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (header, footer, headings)",
        "default": "#1B2A3B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color (buttons, highlights)",
        "default": "#E87722"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text color",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / card background",
        "default": "#f8f9fa"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#e5e7eb"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "inter_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px",
        "label": "Base font size"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled to 32x32px"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Max 150px tall recommended"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "default": 150,
        "unit": "px",
        "label": "Logo max width"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_transparent",
        "label": "Transparent header on homepage",
        "default": false
      }
    ]
  },
  {
    "name": "Product Cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor/brand on cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Show quick add button on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show sale badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_new_badge",
        "label": "Show new badge",
        "default": true
      },
      {
        "type": "range",
        "id": "days_new",
        "min": 7,
        "max": 90,
        "step": 7,
        "default": 30,
        "unit": "days",
        "label": "Days to show 'New' badge"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer (side panel)"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Profiles"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_twitter",
        "label": "Twitter / X URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_linkedin",
        "label": "LinkedIn URL"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Shipping & Policies",
    "settings": [
      {
        "type": "header",
        "content": "Free Shipping"
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping_threshold",
        "label": "Show free shipping threshold",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold amount (in cents)",
        "default": 9900,
        "info": "Set to 9900 for $99.00"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "text",
        "id": "footer_tagline",
        "label": "Footer tagline",
        "default": "Professional kitchen equipment for chefs and home cooks. Quality tools that perform when it matters most."
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons in footer",
        "default": true
      }
    ]
  },
  {
    "name": "Advanced",
    "settings": [
      {
        "type": "header",
        "content": "Custom Code"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Add custom CSS here. Will be appended to the theme stylesheet."
      },
      {
        "type": "textarea",
        "id": "custom_js",
        "label": "Custom JavaScript",
        "info": "Add custom JavaScript here. Will be loaded at the end of the body."
      }
    ]
  }
]
